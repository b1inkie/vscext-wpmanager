{
	"name": "wpmanager",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.6.1",
	"publisher": "lan",
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/b1inkie/vscext-wpmanager"
	},
	"author": {
		"name": "b1inkie",
		"url": "https://gitee.com/b1inkie"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"l10n": "./l10n",
	"activationEvents": [],
	"main": "./extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "wpmanager",
					"title": "%activitybar.title%",
					"icon": "media/workspaces.svg"
				}
			]
		},
		"views": {
			"wpmanager": [
				{
					"id": "wpmanager.workspaces",
					"name": "%view.workspaces%"
				}
			]
		},
		"commands": [
			{
				"command": "wpmanager.generate",
				"category": "%command.category%",
				"title": "%command.generate%"
			},
			{
				"command": "wpmanager.newproject",
				"category": "%command.category%",
				"title": "%command.newproject%"
			},
			{
				"command": "wpmanager.copycurrentpath",
				"category": "%command.category%",
				"title": "%command.copycurrentpath%"
			},
			{
				"command": "wpmanager.editimginPS",
				"category": "%command.category%",
				"title": "%command.editimginPS%"
			},
			{
				"command": "wpmanager.addWorkspaceFile",
				"category": "%command.category%",
				"title": "%command.addWorkspaceFile%",
				"icon": "$(new-file)"
			},
			{
				"command": "wpmanager.addProjectFolder",
				"category": "%command.category%",
				"title": "%command.addProjectFolder%",
				"icon": "$(new-folder)"
			},
			{
				"command": "wpmanager.removeWorkspaceEntry",
				"category": "%command.category%",
				"title": "%command.removeWorkspaceEntry%"
			},
			{
				"command": "wpmanager.showIgnoredWorkspaces",
				"category": "%command.category%",
				"title": "%command.showIgnored%"
			},
			{
				"command": "wpmanager.hideIgnoredWorkspaces",
				"category": "%command.category%",
				"title": "%command.hideIgnored%"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "wpmanager.addWorkspaceFile",
					"group": "navigation@1",
					"when": "view == wpmanager.workspaces"
				},
				{
					"command": "wpmanager.addProjectFolder",
					"group": "navigation@2",
					"when": "view == wpmanager.workspaces"
				}
			],
			"view/item/context": [
				{
					"command": "wpmanager.removeWorkspaceEntry",
					"when": "view == wpmanager.workspaces && viewItem =~ /entry|root/"
				},
				{
					"command": "wpmanager.showIgnoredWorkspaces",
					"when": "view == wpmanager.workspaces && viewItem =~ /root|group/ && viewItem =~ /ign-hidden/"
				},
				{
					"command": "wpmanager.hideIgnoredWorkspaces",
					"when": "view == wpmanager.workspaces && viewItem =~ /root|group/ && viewItem =~ /ign-shown/"
				}
			],
			"commandPalette": [
				{
					"command": "wpmanager.showIgnoredWorkspaces",
					"when": "false"
				},
				{
					"command": "wpmanager.hideIgnoredWorkspaces",
					"when": "false"
				}
			],
			"explorer/context": [
				{
					"command": "wpmanager.editimginPS",
					"when": "resourceScheme == file && resourceExtname =~ /\\.(png|jpe?g|gif|bmp|webp|tiff?|ico)$/i"
				}
			],
			"editor/title/context": [
				{
					"command": "wpmanager.editimginPS",
					"when": "resourceScheme == file && resourceExtname =~ /\\.(png|jpe?g|gif|bmp|webp|tiff?|ico)$/i"
				}
			]
		},
		"configuration": {
			"title": "%displayName%",
			"properties": {
				"wpmanager.photoshopPath": {
					"type": "string",
					"default": "",
					"description": "%config.photoshopPath%"
				},
				"wpmanager.scanMaxDepth": {
					"type": "number",
					"default": 3,
					"minimum": 1,
					"maximum": 8,
					"description": "%config.scanMaxDepth%"
				},
				"wpmanager.scanExcludeNames": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"node_modules",
						".git",
						".venv",
						"dist"
					],
					"description": "%config.scanExcludeNames%"
				}
			}
		}
	},
	"scripts": {
		"package": "npx --yes @vscode/vsce package"
	}
}
